-- Run from a terminal: M2 --script Verify.m2
-- Requires Macaulay2 only. No Python, C++, Singular, or shell subprocess.
-- All circuit masks, leading trees, automaton states, and rational numerators
-- are regenerated from the mathematical classifications in the paper.
load "./Circuits.m2";
load "./Transfer.m2";
load "./AlgebraChecks.m2";

k4VerificationStart = cpuTime();
print "Native Macaulay2 verification of complete bipartite slope models";
print("Macaulay2 version: " | toString version#"VERSION");

scan(toList(0..6), tt -> (
    masks := k4CircuitMasks tt;
    assert(#masks == k4ExpectedCircuitCount tt);
    print("K4," | toString tt | " circuit count: " | toString(#masks));
));
k4VerifiedCircuitData = k4CircuitData 6;
assert(#k4VerifiedCircuitData == 10760);
print "Regenerated and checked all 10760 complementary-tree certificates";
k4VerifiedMachine = k4CompileMachine k4VerifiedCircuitData;
k4VerifiedRationalData = k4VerifyRational k4VerifiedMachine;
scan(toList(3..6), tt -> (
    data := if tt == 6 then k4VerifiedCircuitData else k4CircuitData tt;
    k4NativeHilbertCheck(k4VerifiedMachine,tt,data);
));

-- A small, inspectable native certificate is an output, never an input.
k4CertificatePath = currentFileDirectory | "K4TransferCertificate.m2";
k4CertificatePath << "-- Generated by Verify.m2; not required as input.\n" <<
    "k4GeneratedMachine = " << toExternalString k4VerifiedMachine << ";\n" << close;

runAlgebraChecks();
print("Total CPU seconds: " | toString(cpuTime()-k4VerificationStart));
print "PASS: complete native Macaulay2 verification";
exit 0;
