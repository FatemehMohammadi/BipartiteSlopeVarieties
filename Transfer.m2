--  Macaulay2 finite-language and exact-polynomial certificate.
-- Input circuit data must be generated by Circuits.m2; 

k4AlphabetWeights = apply(16, b -> sum(4, i -> (b // 2^i) % 2));
k4SubsetTable = apply(16, a -> apply(16, b ->
    all(4, i -> (a // 2^i) % 2 <= (b // 2^i) % 2)));

k4WordDivides = (aa, bb) -> (
    pos := 0;
    scan(bb, b -> (
        if pos < #aa and (k4SubsetTable#(aa#pos))#b then pos = pos+1;
    ));
    pos == #aa
);

k4CompileMachine = circuitData -> (
    patternSet := new MutableHashTable;
    scan(circuitData, pair -> (
        cm := pair#0; tm := pair#1;
        used := select(toList(0..5), j -> any(4, i ->
            (cm // 2^(6*i+j)) % 2 == 1));
        word := apply(used, j -> sum(4, i ->
            2^i * ((tm // 2^(6*i+j)) % 2)));
        patternSet#word = true;
    ));
    decorated := sort apply(keys patternSet, p ->
        {#p, sum(p, b -> k4AlphabetWeights#b), p});
    minimal := {};
    scan(decorated, rec -> (
        p := rec#2;
        if not any(minimal, a -> k4WordDivides(a,p)) then
            minimal = append(minimal,p);
    ));
    assert(#keys patternSet == 633);
    assert(#minimal == 55);
    print "Compressed words: 633; minimal forbidden words: 55";

    states := new MutableHashTable;
    stateIndex := new MutableHashTable;
    transitions := new MutableHashTable;
    initial := apply(#minimal, i -> 0);
    states#0 = initial;
    stateIndex#initial = 0;
    count := 1;
    head := 0;
    while head < count do (
        state := states#head;
        row := apply(16, b -> (
            target := apply(#minimal, j -> (
                pos := state#j;
                if (k4SubsetTable#((minimal#j)#pos))#b then pos+1 else pos
            ));
            if any(#minimal, j -> target#j == #(minimal#j)) then -1
            else (
                if not stateIndex#?target then (
                    stateIndex#target = count;
                    states#count = target;
                    count = count+1;
                );
                stateIndex#target
            )
        ));
        transitions#head = row;
        head = head+1;
    );
    assert(count == 7946);
    print "Reachable accepting prefix states: 7946";

    dead := count;
    rows := append(apply(count, i -> apply(transitions#i,
        j -> if j == -1 then dead else j)), apply(16, i -> dead));
    classes := join(apply(count, i -> 0),{1});
    refinements := 0;
    stable := false;
    while not stable do (
        refinements = refinements+1;
        signatures := new MutableHashTable;
        number := 0;
        nextClasses := apply(#rows, i -> (
            signature := {i == dead, apply(rows#i, j -> classes#j)};
            if not signatures#?signature then (
                signatures#signature = number;
                number = number+1;
            );
            signatures#signature
        ));
        stable = (nextClasses == classes);
        classes = nextClasses;
    );
    representatives := new MutableHashTable;
    scan(#classes, i -> (
        cc := classes#i;
        if not representatives#?cc then representatives#cc = i;
    ));
    machineRows := apply(#keys representatives, cc ->
        apply(rows#(representatives#cc), j -> classes#j));
    assert(#machineRows == 70);
    print("Minimal states: " | toString(#machineRows) |
        "; accepting: 69; refinement passes: " | toString refinements);
    new HashTable from {
        "patterns" => minimal,
        "prefixStates" => count,
        "initial" => classes#0,
        "dead" => classes#dead,
        "rows" => machineRows
    }
);

-- The face enumerator is computed by weighting alphabet letter B by w^|B|.
k4FacePolynomials = (machine, tMax, wvar) -> (
    rows := machine#"rows";
    dead := machine#"dead";
    rr := ring wvar;
    weights := apply(16, b -> wvar^(k4AlphabetWeights#b));
    current := new MutableList from apply(#rows, i -> 0_rr);
    current#(machine#"initial") = 1_rr;
    answer := new MutableHashTable;
    scan(tMax+1, tt -> (
        answer#tt = sum(toList current);
        next := new MutableList from apply(#rows, i -> 0_rr);
        scan(#rows, i -> if i != dead and current#i != 0 then (
            scan(16, b -> (
                j := (rows#i)#b;
                if j != dead then next#j = next#j + current#i*weights#b;
            ));
        ));
        current = next;
    ));
    apply(tMax+1, tt -> answer#tt)
);

-- Acyclicity after deleting loops proves a denominator for every word length.
-- For each loop polynomial lambda, take its maximum multiplicity on a path.
k4LoopDenominator = (machine,wvar,xvar) -> (
    rows := machine#"rows";
    dead := machine#"dead";
    vertices := select(toList(0..(#rows-1)), i -> i != dead);
    adj := apply(#rows, i -> if i == dead then {} else
        sort unique select(rows#i, j -> j != i and j != dead));
    indegrees := new MutableList from apply(#rows, i -> 0);
    scan(vertices, i -> scan(adj#i, j -> indegrees#j = indegrees#j+1));
    queue := new MutableHashTable;
    queueSize := 0;
    scan(vertices, i -> if indegrees#i == 0 then (
        queue#queueSize = i; queueSize = queueSize+1;
    ));
    topo := {};
    head := 0;
    while head < queueSize do (
        i := queue#head; head = head+1;
        topo = append(topo,i);
        scan(adj#i, j -> (
            indegrees#j = indegrees#j-1;
            if indegrees#j == 0 then (
                queue#queueSize = j; queueSize = queueSize+1;
            );
        ));
    );
    assert(#topo == 69);
    loops := apply(#rows, i -> sum(16, b ->
        if (rows#i)#b == i then wvar^(k4AlphabetWeights#b) else 0));
    loopTypes := unique apply(vertices, i -> loops#i);
    maxima := apply(loopTypes, lp -> (
        dp := new MutableList from apply(#rows, i -> -100000);
        dp#(machine#"initial") = if loops#(machine#"initial") == lp then 1 else 0;
        scan(topo, i -> scan(adj#i, j -> (
            candidate := dp#i + (if loops#j == lp then 1 else 0);
            if candidate > dp#j then dp#j = candidate;
        )));
        {lp,max apply(vertices,i -> dp#i)}
    ));
    assert(sum(maxima, pair -> pair#1) == 15);
    new HashTable from {
        "topologicalOrder" => topo,
        "loopMaxima" => maxima,
        "denominator" => product(maxima, pair -> (1-xvar*pair#0)^(pair#1))
    }
);

-- Here xvar is the sole top-level variable: its coefficient ring is ZZ[w].
k4TruncatedNumerator = (den, faces, count, xvar) ->
    sum(count, n -> xvar^n * sum(n+1, i ->
        coefficient(xvar^i,den)*faces#(n-i)));

k4HilbertNumerator = (face,dimension,zvar) -> (
    wvar := (gens ring face)#0;
    sum(terms face, term -> (
        ee := (exponents term)#0#0;
        assert(ee <= dimension);
        (leadCoefficient term)*zvar^ee*(1-zvar)^(dimension-ee)
    ))
);

-- Independent check using Macaulay2's native monomial-ideal Hilbert engine.
-- This does not enumerate words or use the rational family formula.
k4NativeHilbertCheck = (machine,tt,circuitData) -> (
    rr := QQ[k4e_0..k4e_(4*tt-1)];
    leadMonomials := apply(circuitData, pair -> product(
        select(toList(0..(4*tt-1)), i -> ((pair#1) // 2^i) % 2 == 1),
        i -> rr_i));
    ii := monomialIdeal leadMonomials;
    hh := numerator hilbertSeries(rr/ii,Reduce=>true);
    zz := (gens ring hh)#0;
    faces := k4FacePolynomials(machine,tt,zz);
    wanted := k4HilbertNumerator(faces#tt,2*tt+5,zz);
    assert(hh == wanted);
    assert(dim(rr/ii) == 2*tt+5);
    print("Native Hilbert-engine cross-check K4," | toString tt | ": PASS");
    true
);

k4VerifyRational = machine -> (
    coefficientRingW := ZZ[k4w];
    seriesRing := coefficientRingW[k4x];
    wvar := promote(coefficientRingW_0,seriesRing);
    xvar := seriesRing_0;
    -- Face coefficients live in the coefficient ring, not a fraction field.
    faces := k4FacePolynomials(machine,15,coefficientRingW_0);
    bound := k4LoopDenominator(machine,wvar,xvar);
    q15 := bound#"denominator";
    p15 := k4TruncatedNumerator(q15,faces,15,xvar);
    q8 := (1-(1+wvar)^2*xvar)^3 *
          (1-(1+3*wvar+2*wvar^2)*xvar)^2 *
          (1-(1+4*wvar+3*wvar^2)*xvar)^3;
    p8 := k4TruncatedNumerator(q8,faces,8,xvar);
    assert(p8*q15 == p15*q8);
    print "Verified exact order-15 bound and order-8 rational identity";

    coefficientRingZ := ZZ[k4z];
    hilbertSeriesRing := coefficientRingZ[k4y];
    zvar := promote(coefficientRingZ_0,hilbertSeriesRing);
    yvar := hilbertSeriesRing_0;
    hp := 0_hilbertSeriesRing;
    scan(8, i -> (
        ci := coefficient(xvar^i,p8);
        scan(terms ci, term -> (
            jj := (exponents term)#0#0;
            exponent := 2*i+5-jj;
            assert(exponent >= 0);
            hp = hp + (leadCoefficient term)*yvar^i*zvar^jj*(1-zvar)^exponent;
        ));
    ));
    qh := (1-yvar)^3*(1-(1+zvar)*yvar)^2*(1-(1+2*zvar)*yvar)^3;
    low := (1-zvar)^5 + yvar*(1-zvar)^3 + yvar^2*(1-zvar);
    shifted := hp-qh*low;
    assert(all(3, i -> coefficient(yvar^i,shifted) == 0));
    numer := shifted // yvar^3;
    assert(numer*yvar^3 == shifted);

    zz := coefficientRingZ_0;
    expected := {
       1+zz+zz^2+zz^3+zz^4+zz^5,
       -7-13*zz-10*zz^2-6*zz^3-zz^4+5*zz^5+12*zz^6,
       21+57*zz+52*zz^2+16*zz^3-21*zz^4-53*zz^5-67*zz^6-7*zz^7,
       -35-125*zz-145*zz^2-37*zz^3+88*zz^4+160*zz^5+151*zz^6+17*zz^7-30*zz^8,
       35+155*zz+225*zz^2+73*zz^3-153*zz^4-247*zz^5-179*zz^6-9*zz^7+68*zz^8+12*zz^9,
       -21-111*zz-196*zz^2-88*zz^3+135*zz^4+215*zz^5+121*zz^6-5*zz^7-46*zz^8-12*zz^9+8*zz^10,
       7+43*zz+90*zz^2+54*zz^3-59*zz^4-101*zz^5-46*zz^6+4*zz^7+8*zz^8,
       -1-7*zz-17*zz^2-13*zz^3+10*zz^4+20*zz^5+8*zz^6
    };
    -- The manuscript coefficient list is verified below after regeneration;
    -- do not use expected as input to the automaton or rational calculation.
    assert(apply(8,i -> coefficient(yvar^i,numer)) == expected);
    topNumer := sum(8,i -> (
        ni := coefficient(yvar^i,numer);
        if i+5 <= (degree ni)#0 then coefficient(zz^(i+5),ni)*yvar^i else 0
    ));
    assert(topNumer == 1+12*yvar-7*yvar^2-30*yvar^3+12*yvar^4+8*yvar^5);
    degreeNumer := sum(8,i -> substitute(coefficient(yvar^i,numer),{zz=>1})*yvar^i);
    assert(degreeNumer == 6-20*yvar-2*yvar^2+44*yvar^3-20*yvar^4);
    assert(all(8,i -> (degree coefficient(yvar^i,numer))#0 <= i+5));

    -- Exact rational identities for the closed leading-coefficient formula.
    leadValues := apply(16,n -> 2^n*(5*n^2+13*n-22)+4*n+24-(if n==0 then 1 else 0));
    qlead := (1-yvar)^2*(1-2*yvar)^3;
    assert(k4TruncatedNumerator(qlead,leadValues,12,yvar) == topNumer);
    -- Standard generating functions for 1,n,n^2 give an exact identity,
    -- independently of the finite coefficient checks immediately above.
    exactLeadNumer := 5*(2*yvar)*(1+2*yvar)*(1-yvar)^2 +
        13*(2*yvar)*(1-2*yvar)*(1-yvar)^2 -
        22*(1-2*yvar)^2*(1-yvar)^2 +
        4*yvar*(1-2*yvar)^3 +
        24*(1-yvar)*(1-2*yvar)^3 - qlead;
    assert(exactLeadNumer == topNumer);
    degreeValues := apply(16,n -> (
        twice := (15*n^2+75*n-234)*3^n+(32*n+288)*2^n-(n+6)*(n+7);
        assert(twice % 2 == 0);
        twice // 2
    ));
    qdegree := (1-yvar)^3*(1-2*yvar)^2*(1-3*yvar)^3;
    assert(k4TruncatedNumerator(qdegree,degreeValues,16,yvar) == degreeNumer);
    exactQuotient := (ff,gg) -> (
        qq := ff // gg;
        assert(qq*gg == ff);
        qq
    );
    twiceDegreeNumer :=
        15*(3*yvar)*(1+3*yvar)*exactQuotient(qdegree,(1-3*yvar)^3) +
        75*(3*yvar)*exactQuotient(qdegree,(1-3*yvar)^2) -
        234*exactQuotient(qdegree,1-3*yvar) +
        32*(2*yvar)*exactQuotient(qdegree,(1-2*yvar)^2) +
        288*exactQuotient(qdegree,1-2*yvar) -
        yvar*(1+yvar)*exactQuotient(qdegree,(1-yvar)^3) -
        13*yvar*exactQuotient(qdegree,(1-yvar)^2) -
        42*exactQuotient(qdegree,1-yvar);
    assert(twiceDegreeNumer == 2*degreeNumer);
    scan(toList(3..15), tt -> (
        hv := k4HilbertNumerator(faces#tt,2*tt+5,zz);
        assert((degree hv)#0 == tt+2);
        assert(coefficient(zz^(tt+2),hv) == leadValues#(tt-3));
        assert(substitute(hv,{zz=>1}) == degreeValues#(tt-3));
    ));
    print "Verified Hilbert substitution, regularity, degree, and final-corner identities";
    print("Degree initial values: " | toString take(degreeValues,6));
    new HashTable from {
        "faceNumerator" => p8,
        "faceDenominator" => q8,
        "denominatorBound" => q15,
        "shiftedHilbertNumerator" => numer,
        "shiftedHilbertDenominator" => qh,
        "loopData" => bound,
        "faces" => faces
    }
);
